---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(18 18 18);
    --aw-color-secondary: rgb(45 45 45);
    --aw-color-accent: rgb(196 196 196);

    --aw-color-text-heading: rgb(12 12 12);
    --aw-color-text-default: rgb(24 24 24);
    --aw-color-text-muted: rgb(24 24 24 / 58%);
    --aw-color-bg-page: rgb(248 248 246);
    --aw-color-bg-page-dark: rgb(12 12 12);

    ::selection {
      background-color: #111;
      color: #fff;
    }
  }
</style>
