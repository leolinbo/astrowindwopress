---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/ProductGallery.astro';

const metadata = {
  title: 'LED Downlight Manufacturer — Recessed Downlights | ENCORE',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Products"
    title="LED Downlight Manufacturer"
    subtitle="Complete downlight systems for every ceiling height and application"
    items={[
      {
        title: 'DELLA Mini Downlight System',
        description:
          'Ultra-compact mini downlight system for tight ceiling spaces. Ideal for residential and light commercial applications.',
      },
      {
        title: 'ELLA Downlight System',
        description:
          'Super modular design combining hotel, residential, commercial, deep anti-glare, and wall washing in one downlight system. Covers all indoor applications.',
      },
      {
        title: 'Galaxy Downlight System',
        description:
          'Small in size but powerful in wattage. Tunable white with smart dimming. Customized for high ceiling 4m-8m height applications.',
      },
      {
        title: 'AVA MR16 Modular Downlight System',
        description:
          'MR16 compatible modular downlight system for flexible beam angle and lamp replacement options.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-optics-web-08.jpg',
      alt: 'ENCORE LED Downlights',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Versatile Downlight Solutions
      </h3>
      From 2-inch mini downlights to high-ceiling commercial solutions.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">ELLA Downlight Gallery</h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our ELLA downlight collection</p>
    <ProductGallery
      images={[
        { src: '/images/products/prod-ella-web-01.jpg', alt: 'ELLA Downlight', title: 'ELLA Downlight' },
        { src: '/images/products/prod-ella-web-02.jpg', alt: 'ELLA Downlight Angle 2', title: 'ELLA — Front View' },
        { src: '/images/products/prod-ella-web-03.jpg', alt: 'ELLA Downlight Angle 3', title: 'ELLA — Side View' },
        { src: '/images/products/prod-ella-web-04.jpg', alt: 'ELLA Downlight Angle 4', title: 'ELLA — Detail' },
        { src: '/images/products/prod-ella-web-05.jpg', alt: 'ELLA Downlight Angle 5', title: 'ELLA — Installation' },
        { src: '/images/products/prod-ella-web-06.jpg', alt: 'ELLA Downlight Angle 6', title: 'ELLA — Application' },
        { src: '/images/products/prod-ella-web-07.jpg', alt: 'ELLA Downlight Angle 7', title: 'ELLA — Close Up' },
        { src: '/images/products/prod-ella-web-08.jpg', alt: 'ELLA Downlight Angle 8', title: 'ELLA — Series' },
      ]}
    />
  </section>
</Layout>
