---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/ProductGallery.astro';

const metadata = {
  title: 'Commercial LED Lighting Manufacturer | ENCORE',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Products"
    title="Commercial LED Lighting Manufacturer"
    subtitle="Complete commercial lighting solutions for retail, hospitality, office, and institutional spaces"
    items={[
      {
        title: 'Cylinder Light System',
        description:
          'Modern cylindrical luminaires for contemporary commercial spaces. Clean lines, high performance, and flexible mounting options.',
      },
      {
        title: 'Linear Light System',
        description:
          'Linear LED lighting for architectural integration. Suitable for suspended, surface, and recessed installations in offices and commercial spaces.',
      },
      {
        title: 'Motorized Remote Controlled Lighting',
        description:
          'Innovative motorized track lights with remote control for adjustable beam positioning. Ideal for spaces requiring dynamic lighting arrangements.',
      },
      {
        title: 'Wall Luminaires & ETL Downlights',
        description:
          'Wall-mounted lighting fixtures and ETL certified downlights for North American commercial projects.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-wallwash-web-03.jpg',
      alt: 'ENCORE Commercial Lighting Solutions',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Complete Commercial Lighting
      </h3>
      Cylinder, linear, motorized, and wall-mounted solutions for every project.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">Product Gallery</h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our commercial lighting collection</p>
    <ProductGallery
      images={[
        { src: '/images/products/prod-movia-web-01.jpg', alt: 'MOVIA Motorized Track Light', title: 'MOVIA Motorized Track Light' },
        { src: '/images/products/prod-movia-web-02.jpg', alt: 'MOVIA Motorized Light Angle', title: 'MOVIA — Angle View' },
        { src: '/images/products/prod-cylinder-nova-300.jpg', alt: 'NOVA Cylinder Light', title: 'NOVA Cylinder Light' },
        { src: '/images/products/prod-cylinder-nova-500.jpg', alt: 'NOVA Cylinder Light 500', title: 'NOVA Cylinder — 500' },
        { src: '/images/products/prod-cylinder-nova-800.jpg', alt: 'NOVA Cylinder Light 800', title: 'NOVA Cylinder — 800' },
        { src: '/images/products/prod-cylinder-galaxy-01.png', alt: 'Galaxy Cylinder Light', title: 'Galaxy Cylinder Light' },
        { src: '/images/products/prod-cylinder-galaxy-02.png', alt: 'Galaxy Cylinder Light Angle', title: 'Galaxy Cylinder — Angle' },
        { src: '/images/products/prod-cylinder-galaxy-03.png', alt: 'Galaxy Cylinder Light DS', title: 'Galaxy Cylinder — DS' },
        { src: '/images/products/prod-linear-atro-01.png', alt: 'ATRO Linear Light', title: 'ATRO Linear Light' },
        { src: '/images/products/prod-linear-atro-02.png', alt: 'ATRO Linear Light Surface', title: 'ATRO Linear — Surface' },
        { src: '/images/products/prod-linear-banner.png', alt: 'Linear Light Banner', title: 'Linear Light — Series' },
        { src: '/images/products/prod-strip-fs28-120.png', alt: 'FS28 Strip Light', title: 'FS28 Strip Light' },
        { src: '/images/products/prod-strip-fs34-160.png', alt: 'FS34 Strip Light', title: 'FS34 Strip Light' },
      ]}
    />
  </section>
</Layout>
