---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/ProductGallery.astro';

const metadata = {
  title: 'Magnetic Track Lighting Manufacturer | ENCORE',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Products"
    title="Magnetic Track Lighting Manufacturer"
    subtitle="Next-generation modular track lighting with magnetic connection system"
    items={[
      {
        title: 'Magnetic Track System',
        description:
          'Innovative magnetic track lighting with easy snap-in fixture installation. Modular design allows for quick reconfiguration as lighting needs change.',
      },
      {
        title: 'Flexible Configuration',
        description:
          'Multiple track lengths, connector options (L/T/X shape), and fixture types. Surface-mounted and recessed versions available.',
      },
      {
        title: 'Modern Aesthetic',
        description:
          'Sleek, minimalist design that blends into contemporary interiors. Ideal for high-end retail, modern offices, and residential projects.',
      },
      {
        title: 'Smart Compatible',
        description:
          'Compatible with leading smart control systems for dimming, color tuning, and automated lighting scenes.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-cutlight-web-03.jpg',
      alt: 'ENCORE Magnetic Track Lighting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        The Future of Track Lighting
      </h3>
      Magnetic connection for effortless installation and reconfiguration.
    </Fragment>
  </Content>

  <!-- Product Gallery -->
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-2 dark:text-white">Product Gallery</h2>
    <p class="text-center text-muted dark:text-slate-400 mb-8">Scroll to explore our lighting collection</p>
    <ProductGallery
      images={[
        { src: '/images/products/prod-flex-web-01.jpg', alt: 'Track Light', title: 'Flex Track Light' },
        { src: '/images/products/prod-flex-web-02.jpg', alt: 'Track Light Angle 2', title: 'Flex — Detail' },
        { src: '/images/products/prod-ovega-web-01.jpg', alt: 'OVEGA Track Light', title: 'OVEGA Track Light' },
        { src: '/images/products/prod-ovega-web-03.jpg', alt: 'OVEGA Track Light Detail', title: 'OVEGA — Close Up' },
        { src: '/images/products/prod-movia-web-01.jpg', alt: 'MOVIA Motorized Light', title: 'MOVIA Motorized Light' },
        { src: '/images/products/prod-movia-web-02.jpg', alt: 'MOVIA Angle View', title: 'MOVIA — Side View' },
      ]}
    />
  </section>
</Layout>
