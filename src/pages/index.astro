---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'ENCORE — Professional Track Lighting & LED Downlight Manufacturer',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get a Quote',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'View Products',
        href: '#products',
      },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'ENCORE Track Lighting Products' }}
  >
    <Fragment slot="title">
      Professional <span class="text-accent dark:text-white">Track Lighting</span> &amp; LED Downlight Manufacturer
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        UL / CE / DLC certified factory. OEM &amp; ODM services available.
        <span class="block mt-1">
          Track lighting, LED downlights, magnetic track systems — custom solutions for commercial and residential projects worldwide.
        </span>
      </span>
      <span class="block sm:hidden">
        UL/CE/DLC certified. OEM &amp; ODM. Global shipping.
      </span>
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="why-us"
    tagline="Why Choose ENCORE"
    title="LED Lighting Manufacturer You Can Trust"
    subtitle="With years of manufacturing expertise, we deliver premium LED lighting solutions for commercial projects worldwide — retail, hospitality, museums, and more."

    items={[
      {
        title: 'ETL / CE / RoHS / ISO Certified',
        description:
          'All our products meet international safety and quality standards. ETL, CE, RoHS, ISO, SAA certified. Full documentation available upon request.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'OEM & ODM Manufacturing',
        description:
          'Custom designs, branding, packaging, and specifications. Our R&D team works with you to create the perfect lighting solution for your market.',
        icon: 'tabler:settings',
      },
      {
        title: 'Strict Quality Control',
        description:
          'Every batch undergoes incoming inspection, SMT assembly, aging test, and final QC before shipment. ISO-standard production lines ensure consistent quality.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Factory Direct Pricing',
        description:
          'No middlemen. Get competitive wholesale pricing directly from the manufacturer. Flexible MOQ for trial orders and new partnerships.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'Global Shipping',
        description:
          'Reliable logistics partners ensure fast delivery worldwide. DDP, FOB, CIF, EXW terms available. HK HQ + Shenzhen factory for efficient supply chain.',
        icon: 'tabler:world',
      },
      {
        title: '5-Year Warranty',
        description:
          'Confidence in our products. We stand behind every shipment with a comprehensive warranty and dedicated after-sales support team.',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Products Content Widget ******** -->

  <Content
    id="products"
    isReversed
    isAfterContent
    tagline="Our Products"
    title="Track Lighting & LED Downlights"
    subtitle="Complete range of commercial and residential lighting solutions"
    items={[
      {
        title: 'Track Lighting Systems',
        description:
          'H-Type, J-Type, L-Type, and magnetic track systems. Single-circuit and dual-circuit options. Linear and flexible configurations for retail, museums, galleries, and residential spaces.',
      },
      {
        title: 'LED Downlights',
        description:
          'Dimmable, IC-rated, and commercial-grade LED downlights. Multiple sizes (4", 6", 8"), wattages, and color temperatures (2700K-5000K). COB and SMD options available.',
      },
      {
        title: 'Magnetic Track Lights',
        description:
          'Next-generation magnetic track lighting systems. Easy installation, modular design, and sleek aesthetics. Ideal for modern commercial and high-end residential projects.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1520128955643-50c3c6b7e4a0?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'ENCORE Lighting Products',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Complete Lighting Solutions for Every Project
      </h3>
      From concept to delivery — we handle every step of the manufacturing process.
    </Fragment>
  </Content>

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Years in Lighting', amount: '10+' },
      { title: 'Product Families', amount: '9' },
      { title: 'Markets Served', amount: '60+' },
      { title: 'Global Projects', amount: '1000+' },
    ]}
  />

  <!-- OEM/ODM Content Widget ******** -->

  <Content
    isAfterContent
    tagline="OEM & ODM Services"
    title="Custom Lighting Manufacturing"
    items={[
      {
        title: 'Custom Design',
        description:
          'Work with our engineering team to develop custom lighting products tailored to your specifications and market requirements.',
      },
      {
        title: 'Branding & Packaging',
        description:
          'Your brand, your packaging. We offer custom logo printing, brand-color finishing, and retail-ready packaging design.',
      },
      {
        title: 'Sample Development',
        description:
          'Rapid prototyping and sample development. Approve the design before mass production. Typical sample lead time: 7-15 days.',
      },
      {
        title: 'Bulk Production',
        description:
          'Factory capacity of 500,000+ units per month. Consistent quality across all production batches with full traceability.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'ENCORE Factory and Manufacturing',
    }}
  >
    <Fragment slot="content">Partner with a manufacturer who understands your business.</Fragment>
  </Content>

  <!-- BlogLatestPosts Widget ******** -->

  <BlogLatestPosts
    title="Latest from Our Blog"
    information="Lighting industry insights, product guides, and company updates from ENCORE."
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Common questions about working with ENCORE as your lighting manufacturing partner."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What certifications do your products have?',
        description:
          'Our products are certified with UL, cUL, ETL, CE, RoHS, and DLC depending on the product line and target market. We also comply with Title 20/Title 24 requirements for California. Contact us for specific certification documents.',
      },
      {
        title: 'What is the minimum order quantity (MOQ)?',
        description:
          "Our standard MOQ is 500 units per model for OEM orders. However, we offer flexible MOQ options for trial orders and new partnerships. Contact our sales team to discuss your specific requirements.",
      },
      {
        title: 'Can you customize products with my brand?',
        description:
          'Absolutely. We offer full OEM and ODM services including custom housing colors, logo printing, branded packaging, custom wattages and color temperatures, and private label solutions. Your brand, your specifications.',
      },
      {
        title: 'What is the typical lead time?',
        description:
          'Sample lead time: 7-15 days. Bulk production lead time: 25-45 days depending on order quantity and customization level. We work with reliable logistics partners for fast shipping worldwide.',
      },
      {
        title: 'Do you offer warranty on your products?',
        description:
          'Yes, we offer a 5-year warranty on all our LED lighting products. Our after-sales team provides prompt support for any quality concerns within the warranty period.',
      },
      {
        title: 'Which payment methods do you accept?',
        description:
          'We accept T/T (wire transfer), L/C (letter of credit), and Alibaba Trade Assurance. Payment terms are negotiable for established partnerships and long-term cooperation.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Request a Quote',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Send Inquiry',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Partner with <span class="sm:whitespace-nowrap">ENCORE</span>?
    </Fragment>
    <Fragment slot="subtitle">
      Get in touch with our team for product information, pricing, or custom manufacturing inquiries.
      <br class="hidden md:inline" /> We typically respond within 24 hours.
    </Fragment>
  </CallToAction>
</Layout>
