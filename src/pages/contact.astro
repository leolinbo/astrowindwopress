---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact Us — Get a Quote from ENCORE',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact Us" title="Get in Touch with ENCORE" />

  <ContactUs
    id="form"
    title="Send Us an Inquiry"
    subtitle="Contact our sales team for product information, pricing, or custom manufacturing inquiries. We typically respond within 24 hours."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name *',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email *',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company Name',
      },
      {
        type: 'text',
        name: 'phone',
        label: 'Phone / WhatsApp',
      },
    ]}
    textarea={{
      label: 'Message *',
    }}
    disclaimer={{
      label:
        'By submitting this form, you agree to be contacted by our sales team regarding your inquiry.',
    }}
    description="Prefer to email directly? Send to sales@encore-tech.com"
  />

  <Features2
    title="Contact Information"
    columns={2}
    items={[
      {
        title: 'Email',
        description: 'sales@encore-tech.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Phone / WhatsApp',
        description: '+852 6768 2519',
        icon: 'tabler:headset',
      },
      {
        title: 'HK Headquarters',
        description:
          'Room 1, 16/F, Empress Plaza 17-19 Chatham Road South, Tsim Sha Tsui, KL',
        icon: 'tabler:building',
      },
      {
        title: 'Shenzhen Factory',
        description:
          '2/F, Bldg 8th, Zhengzhong Industrial Park, Qiaotou Community, Fuyong, Bao\'an Dist, Shenzhen, China',
        icon: 'tabler:building',
      },
      {
        title: 'Technical Support',
        description: 'Rocky Wong — Available for product and technical inquiries',
        icon: 'tabler:user-circle',
      },
      {
        title: 'Response Time',
        description: 'We typically respond within 24 hours on business days',
        icon: 'tabler:clock',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>
