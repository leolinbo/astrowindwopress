---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'About Our LED Lighting Factory Since 2011',
  description:
    'ENCORE is a professional LED lighting manufacturer since 2011 — HK headquarters, Shenzhen factory, ETL/CE/ISO certified. Meet the team behind our track lights.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    tagline="About ENCORE"
    image={{
      src: '~/assets/images/factory/fac-showroom-web-01.jpg',
      alt: 'ENCORE Showroom',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">LED Lighting Manufacturer</span> Since 2011
    </Fragment>
    <Fragment slot="subtitle">
      ENCORE is dedicated to researching, developing and manufacturing high quality LED luminaires and providing premium
      LED lighting solutions for commercial spaces worldwide. Headquartered in Shenzhen, China, with a sound distributor
      system in domestic and overseas markets.
    </Fragment>
  </Hero>

  <!-- Company Story -->
  <Content
    tagline="Our Story"
    title="We Are ENCORE"
    items={[
      {
        title: 'Our Mission',
        description:
          'To create healthy and smart light for our world through continuous innovation and superior quality.',
      },
      {
        title: 'Our Journey',
        description:
          'Starting from 2011, ENCORE has devoted itself to the LED lighting industry. Our journey began with foreign trading and evolved into a full-fledged manufacturer with our own factory, R&D team, and a complete quality management system.',
      },
      {
        title: 'Our Market',
        description:
          'Products are exported to over 85 countries and regions including North America, Europe, Australia, Southeast Asia, Middle East, and Latin America. We serve retail, hospitality, museum, gallery, and commercial office projects.',
      },
      {
        title: 'Our Commitment',
        description:
          'We win customers with value creation, impress with fine craftsmanship, amaze with innovation, and assure with concerted action. Every product reflects our dedication to quality and reliability.',
      },
    ]}
    image={{
      src: '~/assets/images/factory/fac-visit-web-01.jpg',
      alt: 'ENCORE Factory Visit',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Premium LED Lighting Solutions</h3>
      Distinctive in both function and aesthetic design — enhancing commercial spaces worldwide.
    </Fragment>
  </Content>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Years in Lighting', amount: '15+' },
      { title: 'Product Families', amount: '9' },
      { title: 'Export Countries', amount: '85+' },
      { title: 'Global Projects', amount: '1000+' },
    ]}
  />

  <!-- History Timeline -->
  <Steps
    title="Our Journey — Key Milestones"
    items={[
      {
        title: '2011: <span class="font-medium">Founded</span>',
        description:
          'Started as a foreign trading company focused on LED commercial lighting, with a deepening understanding of customer needs and market demands.',
        icon: 'tabler:stars',
      },
      {
        title: '2013: <span class="font-medium">First Track Light</span>',
        description: 'Set up our own R&D team and released the first self-developed LED track light — Aimer.',
        icon: 'tabler:bulb',
      },
      {
        title: '2014: <span class="font-medium">Own Factory</span>',
        description:
          'Established our own factory from 0 to 1, building supply chain management and quality control systems.',
        icon: 'tabler:building',
      },
      {
        title: '2016-17: <span class="font-medium">Growth</span>',
        description:
          'Released 11 new track light products and 3 LED downlight families. Expanded to a new factory with professional facilities.',
        icon: 'tabler:chart-bar',
      },
      {
        title: '2018-19: <span class="font-medium">Certification</span>',
        description:
          'High-tech enterprise certification with multiple patents. Upgraded to ISO9001:2018 quality system and implemented ERP management.',
        icon: 'tabler:award',
      },
      {
        title: '2020+: <span class="font-medium">Innovation</span>',
        description:
          'Launched ELLA, Galaxy, and multiple new product families. Brand upgrade with new vision and mission. Serving 85+ countries.',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: '~/assets/images/factory/fac-office-web-01.jpg',
      alt: 'ENCORE Office',
    }}
  />

  <!-- Factory Facilities -->
  <Content
    isReversed
    tagline="Factory Tour"
    title="Our Shenzhen Factory"
    subtitle="2/F, Bldg 8th, Zhengzhong Industrial Park, Qiaotou Community, Fuyong, Bao'an Dist, Shenzhen"
    items={[
      {
        title: 'Showroom',
        description:
          '900 sqm showroom displaying all 9 product families — track lights, downlights, linear lights, and more.',
      },
      {
        title: 'Production Workshop',
        description:
          'Professional SMT assembly lines, workstations, and assembly areas for efficient manufacturing and consistent quality.',
      },
      {
        title: 'Testing & Aging Lab',
        description:
          'Complete testing facilities for photoelectric, safety, and reliability verification. 100% aging test for every order.',
      },
      {
        title: 'Warehouse & Logistics',
        description:
          '2000 sqm warehouse with inventory management system for efficient order fulfillment and global shipping.',
      },
    ]}
    image={{
      src: '~/assets/images/factory/fac-newfactory-web-01.jpg',
      alt: 'ENCORE Factory Building',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Full In-House Manufacturing</h3>
      From raw materials to finished products — total control over quality and delivery.
    </Fragment>
  </Content>

  <!-- Global Market -->
  <Features2
    title="Global Market Reach"
    subtitle="Products exported to over 85 countries across 6 continents"
    columns={3}
    items={[
      {
        title: 'North America',
        description: 'USA, Canada, Mexico — ETL certified products for commercial projects.',
        icon: 'tabler:world',
      },
      {
        title: 'Europe',
        description: 'EU market with CE (LVD+EMC) certified products for retail, hospitality, and office.',
        icon: 'tabler:world',
      },
      {
        title: 'Australia & Oceania',
        description: 'SAA certified products for Australian and New Zealand markets.',
        icon: 'tabler:world',
      },
      {
        title: 'Southeast Asia',
        description: 'Growing presence in Singapore, Malaysia, Thailand, Vietnam, and Philippines.',
        icon: 'tabler:world',
      },
      {
        title: 'Middle East',
        description: 'Projects in UAE, Saudi Arabia, Qatar for hospitality and retail sectors.',
        icon: 'tabler:world',
      },
      {
        title: 'Latin America',
        description: 'Expanding distribution in Brazil, Mexico, Chile, and Colombia.',
        icon: 'tabler:world',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>
