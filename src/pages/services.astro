---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'LED Lighting Solutions — Commercial, Retail, Hospitality | ENCORE',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Solutions"
    title="LED Lighting Solutions for Every Space"
    subtitle="Comprehensive lighting solutions tailored to commercial, hospitality, retail, museum, and office environments"
    items={[
      {
        title: 'Retail Lighting',
        description:
          'Enhance merchandise displays with precise beam control and high CRI lighting. Track lighting systems with adjustable heads for flexible retail layouts.',
      },
      {
        title: 'Hospitality Lighting',
        description:
          'Create inviting atmospheres in hotels, restaurants, and lounges. Warm, dimmable lighting solutions with elegant fixture designs.',
      },
      {
        title: 'Museum & Gallery Lighting',
        description:
          'Protect artifacts with low-heat LED lighting while achieving perfect color rendering. Anti-glare optics for comfortable viewing experiences.',
      },
      {
        title: 'Office & Commercial',
        description:
          'Efficient, comfortable lighting for productive work environments. Linear and downlight solutions with smart control compatibility.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-optics-web-12.jpg',
      alt: 'ENCORE Commercial Lighting Solutions',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Tailored Lighting for Every Application
      </h3>
      From concept to installation — we provide complete lighting solutions.
    </Fragment>
  </Content>

  <Features
    tagline="Why ENCORE"
    title="Full-Service Lighting Partner"
    subtitle="From product design to global delivery — we handle it all"
    items={[
      {
        title: 'Product Design & Development',
        description:
          'In-house R&D team creates custom lighting solutions tailored to your project requirements. Industrial design, optics, thermal, and electronics capabilities.',
        icon: 'tabler:bulb',
      },
      {
        title: 'OEM & ODM Manufacturing',
        description:
          'Full OEM and ODM services with custom branding, packaging, and specifications. 9 product families to customize for your market.',
        icon: 'tabler:settings',
      },
      {
        title: 'Quality Assurance',
        description:
          'ISO9001:2018 certified quality management. 100% aging test for every order. Full traceability with tracking codes.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Global Logistics',
        description:
          'DDP, FOB, CIF, EXW terms available. Reliable shipping partners for timely worldwide delivery from our Shenzhen base.',
        icon: 'tabler:truck-delivery',
      },
      {
        title: 'After-Sales Support',
        description:
          '5-year warranty on all products. Dedicated after-sales team for prompt resolution of any quality concerns.',
        icon: 'tabler:headset',
      },
      {
        title: 'Certification Management',
        description:
          'We manage certifications for your target market — ETL for North America, CE for Europe, SAA for Australia, and more.',
        icon: 'tabler:award',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Discuss Your Project',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">
      Need a Custom Lighting <span class="sm:whitespace-nowrap">Solution?</span>
    </Fragment>
    <Fragment slot="subtitle">
      Contact our team to discuss your project requirements.
    </Fragment>
  </CallToAction>
</Layout>
