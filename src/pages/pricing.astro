---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Wholesale LED Lighting Pricing & Quotes',
  description:
    'Request wholesale LED lighting pricing for your project. Factory-direct quotes for track lights, downlights and magnetic systems. OEM/ODM welcome.',
};
---

<Layout metadata={metadata}>
  <Content
    tagline="Pricing"
    title="Request a Quote"
    subtitle="As a manufacturer, we provide competitive pricing tailored to your project requirements"
    items={[
      {
        title: 'Custom Quotation',
        description:
          'Every project is unique. Contact our sales team with your requirements — product type, quantity, specifications, and target market — and we will provide a detailed quotation within 24 hours.',
      },
      {
        title: 'Volume Discounts',
        description:
          'We offer tiered pricing based on order volume. Larger quantities benefit from reduced per-unit costs. Contact us for volume pricing.',
      },
      {
        title: 'OEM/ODM Pricing',
        description:
          'Custom products with your branding require a separate quotation process. Our team will work with you to understand your specifications and provide competitive pricing.',
      },
      {
        title: 'Flexible Payment Terms',
        description:
          'We accept T/T (wire transfer), L/C (letter of credit), and Alibaba Trade Assurance. Payment terms negotiable for established partnerships.',
      },
    ]}
    image={{
      src: '~/assets/images/applications/app-optics-web-15.jpg',
      alt: 'ENCORE Lighting Products - Request a Quote',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Competitive Factory-Direct Pricing
      </h3>
      No middlemen. Get the best value directly from the manufacturer.
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Request a Quote',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Email Us',
        href: 'mailto:sales@encore-tech.com',
      },
    ]}
  >
    <Fragment slot="title">
      Get Your <span class="sm:whitespace-nowrap">Custom Quote</span> Today
    </Fragment>
    <Fragment slot="subtitle">
      Contact our sales team for pricing, MOQ information, and product availability.
    </Fragment>
  </CallToAction>
</Layout>
